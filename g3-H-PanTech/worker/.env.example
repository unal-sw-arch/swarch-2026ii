# Worker — nombres iguales a docker-compose.p2.yml / .env.p2.example
RABBITMQ_URL=amqp://panaderia:panaderia@rabbitmq:5672/
CELERY_BROKER_URL=amqp://panaderia:panaderia@rabbitmq:5672/
RABBITMQ_EXCHANGE=panaderia.events
RABBITMQ_DLX=panaderia.dlx
RABBITMQ_DLQ=panaderia.dlq
# Una cola por evento (definitions.json). Agrega worker.reservation_confirmed cuando exista.
# EVENTS_QUEUES=worker.order_paid,worker.order_ready,worker.reservation_created,worker.reservation_cancelled
DECLARE_TOPOLOGY=false

KITCHEN_URL=http://kitchen-service:8001
ORDER_SERVICE_URL=http://order-service:8000
SERVICE_TOKEN=cambia-este-secreto-en-tu-entorno-local

MONGODB_URL=mongodb://panaderia:panaderia@mongodb:27017/panaderia?authSource=admin

S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=panaderia
S3_SECRET_KEY=panaderia123
S3_REGION=us-east-1
S3_BUCKET_RECEIPTS=receipts
S3_USE_SSL=false

WORKER_MAX_RETRIES=3
WORKER_CONCURRENCY=2
HTTP_TIMEOUT_SECONDS=10
