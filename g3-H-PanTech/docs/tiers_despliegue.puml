@startuml
!theme plain
top to bottom direction
skinparam shadowing false
skinparam defaultFontSize 14
skinparam nodesep 40
skinparam ranksep 55
skinparam ArrowFontSize 12
skinparam titleFontSize 18
skinparam titleFontStyle bold
skinparam node {
  FontStyle bold
}
skinparam database {
  FontStyle bold
}

title Vista de Tiers (despliegue en contenedores) - Panadería Express

node "Tier 1 - Presentación" as T1 #E3F2FD;line:1565C0;text:1565C0 {
  node "Navegador web\n(equipo del empleado)" as Browser #FFF9C4;line:F9A825
  node "Contenedor frontend\n:80" as CFront <<Docker>> #BBDEFB;line:1565C0
}

node "Tier 2 - Lógica" as T2 #E8F5E9;line:2E7D32;text:2E7D32 {
  node "Contenedor order-manager\n:8000" as COrder <<Docker>> #C8E6C9;line:2E7D32
  node "Contenedor queue-scheduler\n:8001" as CSched <<Docker>> #C8E6C9;line:2E7D32
}

node "Tier 3 - Datos" as T3 #FFF3E0;line:E65100;text:E65100 {
  database "Contenedor postgres\n:5432" as CPg <<Docker>> #FFE0B2;line:E65100
  database "Contenedor redis\n:6379" as CRedis <<Docker>> #FFCDD2;line:C62828
}

' Conexiones coloreadas por tipo
Browser -[#757575]left-> CFront : Descarga de la SPA
Browser -[#1565C0]down-> COrder : HTTP / REST
Browser -[#6A1B9A]down-> CSched : HTTP Polling
COrder -[#1565C0]right-> CSched : HTTP / REST
COrder -[#E65100]down-> CPg : SQL / TCP
CSched -[#E65100]down-> CPg : SQL / TCP\n(tiempos base + historial)
CSched -[#C62828]down-> CRedis : Redis / TCP

note bottom of T3
  Todos los contenedores se orquestan con docker-compose
  y comparten una red interna.
end note

legend right
  <color:#757575>■</color> Descarga estática
  <color:#1565C0>■</color> HTTP / REST
  <color:#6A1B9A>■</color> HTTP Polling
  <color:#E65100>■</color> SQL / TCP
  <color:#C62828>■</color> Redis / TCP
endlegend

@enduml
