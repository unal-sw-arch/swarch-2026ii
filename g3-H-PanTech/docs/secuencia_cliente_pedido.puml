@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontSize 13
skinparam ArrowFontSize 11
skinparam titleFontSize 18
skinparam titleFontStyle bold
skinparam ParticipantBackgroundColor #BBDEFB
skinparam ParticipantBorderColor #1565C0
skinparam ParticipantFontStyle bold
skinparam ActorBackgroundColor #FFF9C4
skinparam ActorBorderColor #F9A825
skinparam ActorFontStyle bold
skinparam DatabaseBackgroundColor #FFE0B2
skinparam DatabaseBorderColor #E65100
skinparam DatabaseFontStyle bold
skinparam QueueBackgroundColor #FFF9C4
skinparam QueueBorderColor #F9A825
skinparam QueueFontStyle bold
skinparam note {
  BackgroundColor #FFF9C4
  BorderColor #F9A825
  FontStyle bold
}

title Secuencia - Pedido y pago del cliente (Prototipo 2)

actor "Cliente" as Cliente
participant "Web SSR\nNext.js" as Web
participant "API Gateway\nGo" as GW
participant "Identity Service\nKotlin" as Identity
participant "Order Service\nPython" as Order
database "PostgreSQL" as PG
database "MongoDB" as Mongo
queue "RabbitMQ" as MQ
participant "Worker\nCelery" as Worker
participant "Kitchen Service\nGo" as Kitchen
database "Redis" as Redis
database "MinIO" as Minio

== Registro o inicio de sesión ==
Cliente -> Web : Registrarse o iniciar sesión
Web -> GW : POST /auth/register | /auth/login
GW -> Identity : Reenviar credenciales
Identity -> PG : Crear o validar usuario (rol cliente)
Identity --> GW : JWT con roles, permisos y nivel
GW --> Web : JWT
Web --> Cliente : Sesión iniciada

== Menú y creación del pedido ==
Cliente -> Web : Consultar menú y armar pedido para llevar
Web -> GW : GET /menu + JWT
GW -> Order : Reenviar con identidad validada
Order -> Mongo : Leer catálogo y precios
Order --> GW : Menú con precios y tiempos
GW --> Web : Menú
Web --> Cliente : Menú renderizado en el servidor

Cliente -> Web : Confirmar pedido
Web -> GW : POST /orders + JWT
GW -> Order : Crear pedido
Order -> PG : Guardar pedido pendiente de pago
Order --> GW : Pedido creado y total del servidor
GW --> Web : Pedido y total
Web --> Cliente : Total a pagar

== Pago simulado y evento ==
Cliente -> Web : Pagar (tarjeta simulada o efectivo)
Web -> GW : POST /orders/{id}/payment + JWT
GW -> Order : Confirmar pago
Order -> PG : Validar dueño y marcar pagado
Order -> MQ : Publicar order.paid
Order --> GW : Pago confirmado
GW --> Web : Pago aceptado
Web --> Cliente : Pedido en preparación

== Proceso asíncrono ==
MQ -> Worker : Entregar order.paid
Worker -> Kitchen : POST /queue/orders
Kitchen -> Redis : Encolar pedido priorizado
Kitchen --> Worker : Pedido encolado
Worker -> Mongo : Actualizar read model del pedido
Worker -> Minio : Generar comprobante
Worker --> MQ : Ack del evento

== Seguimiento del pedido ==
Cliente -> Web : Consultar el estado de su pedido
Web -> GW : GET /orders/{id}/status + JWT
GW -> Order : Consultar estado
Order -> Mongo : Leer read model
Order --> GW : pendiente | en_preparacion | listo | entregado
GW --> Web : Estado actual
Web --> Cliente : Estado renderizado

note over Order
  El cliente no accede a Kitchen Service,
  a RabbitMQ ni a pedidos ajenos.
  El pago es idempotente: repetir la petición
  no publica dos veces order.paid.
end note

@enduml
