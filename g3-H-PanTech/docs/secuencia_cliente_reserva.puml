@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontSize 13
skinparam ArrowFontSize 11
skinparam titleFontSize 18
skinparam titleFontStyle bold
skinparam ParticipantBackgroundColor #BBDEFB
skinparam ParticipantBorderColor #1565C0
skinparam ParticipantFontStyle bold
skinparam ActorBackgroundColor #FFF9C4
skinparam ActorBorderColor #F9A825
skinparam ActorFontStyle bold
skinparam DatabaseBackgroundColor #FFE0B2
skinparam DatabaseBorderColor #E65100
skinparam DatabaseFontStyle bold
skinparam QueueBackgroundColor #FFF9C4
skinparam QueueBorderColor #F9A825
skinparam QueueFontStyle bold
skinparam note {
  BackgroundColor #FFF9C4
  BorderColor #F9A825
  FontStyle bold
}

title Secuencia - Reserva de mesa del cliente (Prototipo 2)

actor "Cliente" as Cliente
participant "Web SSR\nNext.js" as Web
participant "API Gateway\nGo" as GW
participant "Identity Service\nKotlin" as Identity
participant "Order Service\nPython" as Order
database "PostgreSQL" as PG
queue "RabbitMQ" as MQ
participant "Worker\nCelery" as Worker
database "MongoDB" as Mongo

== Inicio de sesión ==
Cliente -> Web : Iniciar sesión
Web -> GW : POST /auth/login
GW -> Identity : Validar credenciales
Identity -> PG : Consultar usuario
Identity --> GW : JWT con roles, permisos y nivel
GW --> Web : JWT
Web --> Cliente : Sesión iniciada

== Crear reserva ==
Cliente -> Web : Elegir fecha, hora y número de personas
Web -> GW : POST /reservations + JWT
GW -> Order : Crear reserva
Order -> PG : Guardar reserva con dueño y estado pendiente
Order -> MQ : Publicar reservation.created
Order --> GW : Reserva creada
GW --> Web : Reserva pendiente
Web --> Cliente : Reserva registrada

== Proceso asíncrono ==
MQ -> Worker : Entregar reservation.created
Worker -> Mongo : Actualizar read model de reservas
Worker -> MQ : Notificación simulada al cliente

== Consultar mis reservas ==
Cliente -> Web : Ver mis reservas
Web -> GW : GET /reservations + JWT
GW -> Order : Consultar reservas
Order -> PG : Leer solo las reservas del cliente
Order --> GW : Reservas propias
GW --> Web : Lista de reservas
Web --> Cliente : Reservas renderizadas

== Cancelar reserva ==
Cliente -> Web : Cancelar una reserva propia
Web -> GW : PUT /reservations/{id} + JWT
GW -> Order : Cancelar reserva
Order -> PG : Validar dueño y marcar cancelada
Order -> MQ : Publicar reservation.cancelled
Order --> GW : Reserva cancelada
GW --> Web : Confirmación
Web --> Cliente : Cancelación confirmada

note over Order
  El personal con rol mesero, supervisor o admin
  gestiona todas las reservas.
  El cliente solo crea, consulta y cancela las suyas.
  La validación de propiedad se hace con el JWT.
end note

@enduml
