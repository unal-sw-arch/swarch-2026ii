@startuml
!theme plain
skinparam shadowing false
skinparam defaultFontSize 14
skinparam ArrowFontSize 12
skinparam titleFontSize 18
skinparam titleFontStyle bold
skinparam ParticipantBackgroundColor #BBDEFB
skinparam ParticipantBorderColor #1565C0
skinparam ParticipantFontStyle bold
skinparam ActorBackgroundColor #FFF9C4
skinparam ActorBorderColor #F9A825
skinparam ActorFontStyle bold
skinparam DatabaseBackgroundColor #FFE0B2
skinparam DatabaseBorderColor #E65100
skinparam DatabaseFontStyle bold
skinparam note {
  BackgroundColor #FFF9C4
  BorderColor #F9A825
  FontStyle bold
}

title Secuencia - Reserva de mesa del cliente (Prototipo 2)

actor "Cliente" as Cliente
participant "Web App" as Web
participant "Auth Service\n:8002" as Auth
participant "Order Manager\n:8000" as Order
database "PostgreSQL" as DB

== Inicio de sesión ==
Cliente -> Web : Iniciar sesión
Web -> Auth : POST /auth/login
Auth -> DB : Validar credenciales
Auth --> Web : JWT con rol cliente
Web --> Cliente : Sesión iniciada

== Crear reserva ==
Cliente -> Web : Elegir fecha, hora y número de personas
Web -> Order : POST /reservations + JWT
Order -> DB : Guardar reserva con dueño y estado pendiente
Order --> Web : Reserva creada
Web --> Cliente : Reserva pendiente

== Consultar mis reservas ==
Cliente -> Web : Ver mis reservas
Web -> Order : GET /reservations + JWT
Order -> DB : Leer solo las reservas del cliente
Order --> Web : Reservas propias
Web --> Cliente : Lista de reservas propias

== Cancelar reserva ==
Cliente -> Web : Cancelar una reserva propia
Web -> Order : PUT /reservations/{id} + JWT
Order -> DB : Validar dueño y marcar cancelada
Order --> Web : Reserva cancelada
Web --> Cliente : Confirmación de cancelación

note over Order
  El personal con rol mesero o admin
  gestiona todas las reservas.
  El cliente solo crea, consulta y cancela las suyas.
end note

@enduml
