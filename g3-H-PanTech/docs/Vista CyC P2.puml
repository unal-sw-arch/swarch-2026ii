@startuml
!theme plain
top to bottom direction
skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontSize 14
skinparam nodesep 35
skinparam ranksep 60
skinparam ArrowFontSize 12
skinparam titleFontSize 18
skinparam titleFontStyle bold

skinparam component {
  BackgroundColor<<Cliente web>> #BBDEFB
  BorderColor<<Cliente web>> #1565C0
  BackgroundColor<<Servicio>> #C8E6C9
  BorderColor<<Servicio>> #2E7D32
  BackgroundColor<<Seguridad>> #E1BEE7
  BorderColor<<Seguridad>> #6A1B9A
  FontStyle bold
}
skinparam database {
  BackgroundColor<<BD relacional>> #FFE0B2
  BorderColor<<BD relacional>> #E65100
  BackgroundColor<<BD NoSQL clave-valor>> #FFCDD2
  BorderColor<<BD NoSQL clave-valor>> #C62828
  FontStyle bold
}
skinparam actor {
  BackgroundColor #FFF9C4
  BorderColor #F9A825
}

title
  Vista C&C (Componentes y Conectores) - Panadería Express
  Prototipo 2
end title

actor "Empleado\n(Mesero / Cocinero / Despachador / Administrador)" as Empleado

component "Web App\nReact + Vite" as Frontend <<Cliente web>>
component "Auth Service\nFastAPI :8002" as Auth <<Servicio>> <<Seguridad>>
component "Order Manager\nFastAPI :8000" as Order <<Servicio>>
component "Queue Scheduler\nFastAPI :8001" as Scheduler <<Servicio>>
database "PostgreSQL\n:5432" as RDB <<BD relacional>>
database "Redis\n:6379" as NDB <<BD NoSQL clave-valor>>

' Usuario final
Empleado -[#F9A825]down-> Frontend : 1. Navegador web

' Conectores (interfaz requerida), coloreados por tipo
Frontend -[#00897B]down-> Auth : <<HTTPS / REST>>\n2. Registro, login y sesión
Frontend -[#1565C0]down-> Order : <<HTTP / REST + JWT>>\n3. Pedidos, menú, productos y reservas
Frontend -[#6A1B9A]down-> Scheduler : <<HTTP Polling + JWT>>\n4. Cola, despacho, estados e historial
Order -[#00838F]right-> Scheduler : <<HTTP / REST + credencial de servicio>>\n5. Encolar pedido nuevo
Auth -[#E65100]down-> RDB : <<SQL / TCP>>\n9. Usuarios y roles (esquema auth)
Order -[#E65100]down-> RDB : <<SQL / TCP>>\n6. Persistir productos, pedidos y reservas
Scheduler -[#E65100]down-> RDB : <<SQL / TCP>>\n7. Tiempos base e historial de estados
Scheduler -[#C62828]down-> NDB : <<Redis / TCP>>\n8. Cola priorizada y estados

@enduml
