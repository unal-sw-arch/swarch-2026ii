# Web SSR — variables de entorno
# Copia este archivo como .env.local para desarrollo.

# URL interna del API Gateway. En Docker es http://api-gateway:8080.
API_GATEWAY_URL=http://localhost:8080

# Nombres de las cookies httpOnly. Deben coincidir con el compose.
JWT_COOKIE_NAME=panaderia_access
JWT_REFRESH_COOKIE_NAME=panaderia_refresh

# true solo con HTTPS. En desarrollo local queda false.
COOKIE_SECURE=false

# Valores públicos que se incrustan en el HTML.
NEXT_PUBLIC_APP_NAME=Panadería Express
NEXT_PUBLIC_POLL_INTERVAL_MS=4000

# Pruebas E2E (opcionales).
E2E_BASE_URL=http://localhost:3000
E2E_CLIENT_EMAIL=cliente@demo.com
E2E_CLIENT_PASSWORD=Demo1234!
E2E_ADMIN_EMAIL=admin@demo.com
E2E_ADMIN_PASSWORD=Demo1234!
