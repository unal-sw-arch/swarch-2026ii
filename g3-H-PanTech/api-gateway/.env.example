# API Gateway — variables de ejemplo (nombres canónicos de docs/equipo/contratos.md).
# Dentro del compose se pasan desde .env.p2; aquí sirven para correr el servicio a mano.
PORT=8080
IDENTITY_URL=http://localhost:8002
ORDER_URL=http://localhost:8000
KITCHEN_URL=http://localhost:8001
REPORTING_URL=http://localhost:8003
REDIS_URL=redis://localhost:6379/0
JWKS_URL=http://localhost:8002/.well-known/jwks.json
JWT_ISSUER=identity-service
JWT_AUDIENCE=panaderia-express
SERVICE_TOKEN=cambia-este-secreto-en-tu-entorno-local
# Orígenes permitidos (CORS), separados por coma.
CORS_ORIGINS=http://localhost:3000
# Rate limiting por minuto (opcionales; por defecto 120 por usuario y 300 por IP).
RATE_LIMIT_USER_PER_MINUTE=120
RATE_LIMIT_IP_PER_MINUTE=300
