# Order Service — nombres iguales a los de docker-compose.p2.yml / .env.p2.example
PORT=8000
DATABASE_URL=postgresql+psycopg2://panaderia:panaderia@postgres:5432/panaderia   # se normaliza a psycopg 3
MONGODB_URL=mongodb://panaderia:panaderia@mongodb:27017/panaderia?authSource=admin
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://panaderia:panaderia@rabbitmq:5672/
RABBITMQ_EXCHANGE=panaderia.events

# JWT RS256 de identity-service (JWKS). Para desarrollo sin Identity: JWT_PUBLIC_KEY_FILE o JWT_PUBLIC_KEY (PEM).
JWKS_URL=http://identity-service:8002/.well-known/jwks.json
JWT_ISSUER=identity-service
JWT_AUDIENCE=panaderia-express
# JWT_PUBLIC_KEY_FILE=/keys/public.pem

SERVICE_TOKEN=cambia-este-secreto-en-tu-entorno-local

BUSINESS_TZ=America/Bogota
SEED_MENU=true
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_SECONDS=2
# Poner en true solo cuando exista la cola worker.reservation_confirmed en definitions.json
PUBLISH_RESERVATION_CONFIRMED=false
