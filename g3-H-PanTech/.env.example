# Copia este archivo a `.env` si quieres personalizar algo.
# `docker compose up` funciona igual sin crear el `.env` (usa estos valores).

# --- Credenciales de PostgreSQL ---
POSTGRES_USER=panaderia
POSTGRES_PASSWORD=panaderia
POSTGRES_DB=panaderia

# --- Puertos publicados en el host ---
FRONTEND_PORT=80
ORDER_MANAGER_PORT=8000
SCHEDULER_PORT=8001
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# --- URLs del frontend (las usa el navegador) ---
VITE_ORDER_API_URL=http://localhost:8000
VITE_SCHEDULER_API_URL=http://localhost:8001
VITE_POLL_INTERVAL_MS=3000

# --- TTL (segundos) de las comandas entregadas en Redis ---
DELIVERED_TTL_SECONDS=3600
