# Normalización de finales de línea.
# Los scripts de shell deben viajar con LF para funcionar dentro de Linux.
* text=auto
.gitattributes text eol=lf
.env* text eol=lf
*.sh text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.js text eol=lf
*.json text eol=lf
*.puml text eol=lf
*.md text eol=lf
