# =============================================================================
# Panadería Express — Prototipo 2
# Variables de entorno de ejemplo.
#
# Uso:
#   cp .env.p2.example .env.p2
#   docker compose -f docker-compose.p2.yml --env-file .env.p2 up --build
#
# No guardes secretos reales en este archivo. `.env.p2` está en .gitignore.
# Los valores de aquí son solo para desarrollo local.
# =============================================================================

# -----------------------------------------------------------------------------
# Red y proyecto
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=panaderia-p2
NETWORK_NAME=panaderia-net

# -----------------------------------------------------------------------------
# Puertos publicados en el host (solo borde y consolas)
# -----------------------------------------------------------------------------
WEB_SSR_HOST_PORT=3000
API_GATEWAY_HOST_PORT=8080
RABBITMQ_MANAGEMENT_HOST_PORT=15672
MINIO_CONSOLE_HOST_PORT=9001

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=panaderia
POSTGRES_PASSWORD=panaderia
POSTGRES_DB=panaderia
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Formato para SQLAlchemy / servicios Python
DATABASE_URL=postgresql+psycopg2://panaderia:panaderia@postgres:5432/panaderia
# Formato para JDBC / .NET
DATABASE_URL_JDBC=jdbc:postgresql://postgres:5432/panaderia
DATABASE_URL_DOTNET=Host=postgres;Port=5432;Database=panaderia;Username=panaderia;Password=panaderia
# Formato para Go (pgx)
DATABASE_URL_GO=postgres://panaderia:panaderia@postgres:5432/panaderia?sslmode=disable

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=panaderia
MONGO_INITDB_ROOT_PASSWORD=panaderia
MONGO_INITDB_DATABASE=panaderia
MONGODB_URL=mongodb://panaderia:panaderia@mongodb:27017/panaderia?authSource=admin

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_DB=1
REDIS_CACHE_DB=2

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=panaderia
RABBITMQ_DEFAULT_PASS=panaderia
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_URL=amqp://panaderia:panaderia@rabbitmq:5672/
RABBITMQ_EXCHANGE=panaderia.events
RABBITMQ_DLX=panaderia.dlx
RABBITMQ_DLQ=panaderia.dlq

# -----------------------------------------------------------------------------
# MinIO
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=panaderia
MINIO_ROOT_PASSWORD=panaderia123
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=panaderia
MINIO_SECRET_KEY=panaderia123
MINIO_BUCKET_RECEIPTS=receipts
MINIO_BUCKET_PRODUCTS=products
MINIO_BUCKET_REPORTS=reports
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# Seguridad
# -----------------------------------------------------------------------------
# Secreto compartido solo para el prototipo. En producción se reemplaza por mTLS
# o por un mecanismo de identidad de servicio.
SERVICE_TOKEN=cambia-este-secreto-en-tu-entorno-local

JWT_ISSUER=identity-service
JWT_AUDIENCE=panaderia-express
JWT_ALGORITHM=RS256
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Rutas dentro del contenedor de Identity. Las claves se generan en el arranque
# si no existen (solo para desarrollo).
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWKS_URL=http://identity-service:8002/.well-known/jwks.json

# Cookies de la Web SSR
JWT_COOKIE_NAME=panaderia_access
JWT_REFRESH_COOKIE_NAME=panaderia_refresh
COOKIE_SECURE=false

# Orígenes permitidos por el API Gateway (CORS)
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Servicios — puertos internos
# -----------------------------------------------------------------------------
IDENTITY_PORT=8002
ORDER_PORT=8000
KITCHEN_PORT=8001
REPORTING_PORT=8003
GATEWAY_PORT=8080
WEB_SSR_PORT=3000

IDENTITY_URL=http://identity-service:8002
ORDER_URL=http://order-service:8000
KITCHEN_URL=http://kitchen-service:8001
REPORTING_URL=http://reporting-service:8003
API_GATEWAY_URL=http://api-gateway:8080

# -----------------------------------------------------------------------------
# Web SSR
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Panadería Express
NEXT_PUBLIC_POLL_INTERVAL_MS=4000

# -----------------------------------------------------------------------------
# Kitchen Service
# -----------------------------------------------------------------------------
# Cuánto baja el score por cada minuto en espera (aging).
AGING_FACTOR=0.5
# Pedidos que la cocina puede preparar a la vez.
KITCHEN_CAPACITY=4
# Minutos por defecto si un producto no tiene tiempo base.
DEFAULT_PREP_MINUTES=5

# -----------------------------------------------------------------------------
# Worker
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=amqp://panaderia:panaderia@rabbitmq:5672/
CELERY_RESULT_BACKEND=redis://redis:6379/3
WORKER_CONCURRENCY=2
WORKER_MAX_RETRIES=3
