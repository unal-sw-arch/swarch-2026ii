# Kitchen Service — variables de ejemplo (nombres canónicos de docs/equipo/contratos.md).
# Dentro del compose se pasan desde .env.p2; aquí sirven para correr el servicio a mano.
PORT=8001
# DATABASE_URL es la canónica; si está vacía se usa DATABASE_URL_GO.
DATABASE_URL=postgres://panaderia:panaderia@localhost:5432/panaderia?sslmode=disable
REDIS_QUEUE_URL=redis://localhost:6379/1
RABBITMQ_URL=amqp://panaderia:panaderia@localhost:5672/
RABBITMQ_EXCHANGE=panaderia.events
SERVICE_TOKEN=cambia-este-secreto-en-tu-entorno-local
# Cuánto baja el score por cada minuto en espera.
AGING_FACTOR=0.5
# Pedidos que la cocina prepara a la vez.
KITCHEN_CAPACITY=4
# Minutos por defecto si no hay tiempo base.
DEFAULT_PREP_MINUTES=5
