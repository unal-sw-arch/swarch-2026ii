# =============================================================================
# infra/redis/.env.example — nombres de variables (SIN valores reales)
# Copiar a infra/redis/.env (NO versionado) y rellenar con secretos reales.
# Contraseñas: >= 32 caracteres aleatorios, distintas por usuario y por entorno.
# El archivo users.acl guarda HASHES SHA-256 de estas contraseñas, nunca el claro.
# =============================================================================

# --- Conexión de la app a redis-coord (locks; rate limit en Fase 3) ---
REDIS_COORD_MODE=standalone            # standalone | sentinel | cluster (solo standalone, Fase 1)
REDIS_COORD_HOST=redis-coord
REDIS_COORD_PORT=6379
REDIS_COORD_NODES=                     # host:port,host:port (sentinel/cluster, Fase 8)
REDIS_COORD_SENTINEL_MASTER=
REDIS_COORD_USER=svc-serviya-coord
REDIS_COORD_PASSWORD=
REDIS_COORD_SSL=false
REDIS_COORD_TIMEOUT=2s
REDIS_COORD_CONNECT_TIMEOUT=2s

# --- Conexión de la app a redis-cache (caché; se usa en Fase 6) ---
REDIS_CACHE_MODE=standalone
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_NODES=
REDIS_CACHE_SENTINEL_MASTER=
REDIS_CACHE_USER=svc-serviya-cache
REDIS_CACHE_PASSWORD=
REDIS_CACHE_SSL=false
REDIS_CACHE_TIMEOUT=1s
REDIS_CACHE_CONNECT_TIMEOUT=2s

# --- Contraseñas de usuarios ACL (consumidas por render-acl.sh, Fase 1) ---
REDIS_ADMIN_PASSWORD=
REDIS_HEALTHCHECK_PASSWORD=
REDIS_MONITOR_PASSWORD=
REDIS_SVC_SERVIYA_COORD_PASSWORD=
REDIS_SVC_NOTIFICATIONS_COORD_PASSWORD=   # notifications-service (solo PING, modo degradado D-07/1a)
REDIS_SVC_SERVIYA_CACHE_PASSWORD=
