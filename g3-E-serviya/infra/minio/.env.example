# infra/minio/.env.example — ajustes locales de MinIO/Silo
# Copiar al .env raíz (el compose se ejecuta desde la raíz).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_CHAT_ACCESS_KEY=chat
MINIO_CHAT_SECRET_KEY=
MINIO_BUCKET=chat-attachments
MINIO_REGION=us-east-1
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
