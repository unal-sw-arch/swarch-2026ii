# Database Configuration
DB_URL=jdbc:mysql://mysql:3306/marketplace_services?useUnicode=true&connectionCollation=utf8mb4_unicode_ci&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=dev
DB_NAME=marketplace_services
MYSQL_ROOT_PASSWORD=dev

# JWT (RF-001/RF-002) — access tokens ES256 + JWKS (Fase 1, documents/microservicios/guia-implementacion-auth.md).
# Firma ASIMETRICA: SOLO el emisor tiene la clave privada; gateway/servicios verifican con la publica (JWKS).
# Genera un par EC P-256 y pega el base64 del DER (una sola linea, sin cabeceras PEM):
#   openssl ecparam -name prime256v1 -genkey -noout -out ec-priv.pem
#   openssl pkcs8 -topk8 -nocrypt -in ec-priv.pem -out ec-priv-pkcs8.pem
#   JWT_PRIVATE_KEY = base64 del DER:  grep -v -- ----- ec-priv-pkcs8.pem | tr -d '\n'
#   openssl ec -in ec-priv.pem -pubout -out ec-pub.pem
#   JWT_PUBLIC_KEY  = base64 del DER:  grep -v -- ----- ec-pub.pem | tr -d '\n'
# La app falla al arrancar si faltan, no decodifican o no son EC P-256 (fail-fast). NO versionar claves reales.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=serviya-dev-1
# Opcionales (tienen default en application.yaml): iss logico estable, aud de la API, vida del token, typ.
JWT_ISSUER=https://auth.serviya.local
JWT_AUDIENCE=marketplace-api
JWT_ACCESS_TTL=15m

# JWT_SECRET (HS256): el MONOLITO ya NO lo usa (migro a ES256, Fase 1). Sigue siendo necesario para
# notifications-service, que aun verifica HS256 hasta su conversion a resource server (Fase 4). >= 32 chars.
JWT_SECRET=

# PII (RNF-005) — passphrase para el cifrado AES-256-GCM de document_number/phone_number
# IMPORTANTE: Debe configurarse un valor seguro en .env local o variables de entorno.
# NO usar el valor de ejemplo en producción. La app falla al arrancar si está vacío o usa valores débiles.
ENCRYPTION_KEY=

# RabbitMQ — bus entre el monolito (outbox) y notifications-service.
RABBITMQ_USER=serviya
RABBITMQ_PASSWORD=
# chat-service: usuario RabbitMQ para consumir eventos y publicar chat/notificaciones.
CHAT_RABBITMQ_PASSWORD=

# notifications-service (microservicio, ver documents/microservicios/notifications-service.md)
# NOTIFICATIONS_PAYLOAD_KEY: clave COMPARTIDA monolito <-> servicio para sellar (AES-GCM) el correo y los datos
#   protegidos (p. ej. el enlace de reset) que viajan por el outbox y RabbitMQ. >= 32 chars aleatorios; la MISMA
#   en ambos. Ambos fallan al arrancar si falta o es debil.
# NOTIFICATIONS_ENCRYPTION_KEY: clave PROPIA del servicio para el correo del destinatario en reposo.
NOTIFICATIONS_PAYLOAD_KEY=
NOTIFICATIONS_ENCRYPTION_KEY=
NOTIFICATIONS_DB_USER=notifications
NOTIFICATIONS_DB_PASSWORD=
NOTIFICATIONS_MYSQL_ROOT_PASSWORD=

# Brevo API (lo usa notifications-service; el monolito ya no envia correos)
EMAIL_ENABLED=true
EMAIL_API_KEY=key-brevo
EMAIL_FROM=example@serviya.com
EMAIL_FROM_NAME=ServiYa

# Recuperacion de contrasena (RF-003) — URL COMPLETA del enlace que viaja en el correo (el backend
# le agrega ?token=...). Debe incluir el path /reset-password. La compose de dev ya la sobreescribe
# a :5173. Vite dev: http://localhost:5173/reset-password | frontend dockerizado (prod): :8081
FRONTEND_RESET_URL=http://localhost:5173/reset-password

# Frontend API URL (Vite build-time env var)
# Vacío = URLs relativas → nginx proxya /api/ al backend. Funciona con ngrok.
# En dev, docker-compose.dev.yml lo sobreescribe a http://localhost:8080.
VITE_API_URL=

# Chat service (greenfield). La ruta del gateway apunta a estos hosts internos.
CHAT_SERVICE_URI=http://chat-service:8000
CHAT_WS_URI=ws://chat-service:8000

# MinIO: adjuntos del chat (perfil `minio` del docker-compose raíz).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_CHAT_ACCESS_KEY=chat
MINIO_CHAT_SECRET_KEY=
MINIO_BUCKET=chat-attachments
MINIO_REGION=us-east-1
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Redis (sustrato de coordinación — locks; ver documents/redis/). Valores DEV de ejemplo.
# En producción: contraseñas >=32 chars aleatorios por gestor de secretos (D-14/ADR-004).
# App → redis-coord (REDIS_COORD_PASSWORD debe = REDIS_SVC_SERVIYA_COORD_PASSWORD: es el mismo usuario):
REDIS_COORD_HOST=redis-coord
REDIS_COORD_PORT=6379
REDIS_COORD_USER=svc-serviya-coord
REDIS_COORD_PASSWORD=dev-redis-svc-serviya-coord-change-me-0001
# Contraseñas de usuarios ACL (consumidas por render-acl.sh y por el healthcheck del contenedor):
REDIS_ADMIN_PASSWORD=dev-redis-admin-change-me-00000000000000
REDIS_HEALTHCHECK_PASSWORD=dev-redis-healthcheck-change-me-00000
REDIS_MONITOR_PASSWORD=dev-redis-monitor-change-me-0000000000
REDIS_SVC_SERVIYA_COORD_PASSWORD=dev-redis-svc-serviya-coord-change-me-0001
# notifications-service → redis-coord (usuario ACL que SOLO puede hacer PING; modo degradado D-07/1a):
REDIS_SVC_NOTIFICATIONS_COORD_PASSWORD=dev-redis-svc-notifications-coord-change-me-01
# gateway → redis-coord (Fase 4): usuario ACL propio svc-gateway-coord (lee min_iat + opera rl:*). El
# gateway lo usa directo como REDIS_COORD_PASSWORD de su servicio (ver docker-compose.yml). Mismo valor aquí.
REDIS_SVC_GATEWAY_COORD_PASSWORD=dev-redis-svc-gateway-coord-change-me-0001
# chat-service → redis-coord (usuario ACL `chat`, solo claves chat:*; lo usan render-acl.sh y el chat):
REDIS_CHAT_PASSWORD=dev-redis-chat-change-me-000000000000000000000

# chat-service (backend/chat-service, ver documents/microservicios/chat/decisiones-infraestructura-implementacion.md)
CHAT_DB_USER=chat
CHAT_DB_PASSWORD=
CHAT_DB_ROOT_PASSWORD=
# Verificación de JWT ES256 por JWKS (DP-03): DIRECTO del monolito (emisor) por la red interna. El JWKS
# NO se expone en el gateway (P3.3, es privado); igual que notif. El chat no arranca sin JWT_ISSUER.
JWT_JWKS_URL=http://backend:8080/.well-known/jwks.json
JWT_ISSUER=https://auth.serviya.local
JWT_AUDIENCE=marketplace-api
# Orígenes permitidos en el handshake WebSocket del chat (mismos que el CORS del gateway).
ALLOWED_WS_ORIGINS=http://localhost:5173,http://localhost:8081
