<mxfile host="drawio">
  <diagram id="cc-view" name="Vista C&amp;C">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Título -->
        <mxCell id="title" value="&lt;b&gt;Pilosia - Vista de Componentes y Conectores (C&amp;amp;C)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- Usuario -->
        <mxCell id="user" value="Estudiante / Docente&lt;br&gt;(navegador web)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="140" y="60" width="30" height="60" as="geometry" />
        </mxCell>

        <!-- Presentación -->
        <mxCell id="frontend" value="&lt;b&gt;pilosia-frontend&lt;/b&gt;&lt;br&gt;&amp;laquo;presentación&amp;raquo;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;React (JavaScript) + nginx&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="380" y="60" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- Lógica -->
        <mxCell id="courses" value="&lt;b&gt;courses-service&lt;/b&gt;&lt;br&gt;&amp;laquo;lógica&amp;raquo;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Python + FastAPI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="140" y="270" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="grades" value="&lt;b&gt;grades-service&lt;/b&gt;&lt;br&gt;&amp;laquo;lógica&amp;raquo;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Node.js (JavaScript) + Apollo Server&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="620" y="270" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- Datos -->
        <mxCell id="coursesdb" value="&lt;b&gt;courses-db&lt;/b&gt;&lt;br&gt;&amp;laquo;datos&amp;raquo;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PostgreSQL (relacional)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="185" y="460" width="150" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gradesdb" value="&lt;b&gt;grades-db&lt;/b&gt;&lt;br&gt;&amp;laquo;datos&amp;raquo;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;MongoDB (NoSQL)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="665" y="460" width="150" height="100" as="geometry" />
        </mxCell>

        <!-- Conectores -->
        <mxCell id="e-user" value="HTTP" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="frontend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-rest1" value="REST (HTTP / JSON)" style="endArrow=block;endFill=1;html=1;strokeColor=#1f4e79;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="frontend" target="courses">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-gql" value="GraphQL (HTTP / JSON)" style="endArrow=block;endFill=1;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="frontend" target="grades">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-rest2" value="REST (HTTP / JSON)&lt;br&gt;validar inscripción en el grupo" style="endArrow=block;endFill=1;html=1;strokeColor=#1f4e79;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="grades" target="courses">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-sql" value="SQL (protocolo PostgreSQL)" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="courses" target="coursesdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-mongo" value="Protocolo MongoDB" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="grades" target="gradesdb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Convenciones -->
        <mxCell id="legend" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="140" y="600" width="720" height="120" as="geometry" />
        </mxCell>
        <mxCell id="legend-title" value="&lt;b&gt;Convenciones&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="155" y="605" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-pres" value="Presentación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="155" y="635" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg-logic" value="Lógica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="155" y="675" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg-data" value="Datos" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="275" y="635" width="70" height="70" as="geometry" />
        </mxCell>

        <mxCell id="lg-rest-a" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#1f4e79;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="380" y="640" as="sourcePoint" />
            <mxPoint x="450" y="640" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lg-rest-t" value="Conector HTTP REST" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="630" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-gql-a" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="380" y="665" as="sourcePoint" />
            <mxPoint x="450" y="665" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lg-gql-t" value="Conector HTTP GraphQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="655" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-db-a" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#666666;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="380" y="690" as="sourcePoint" />
            <mxPoint x="450" y="690" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lg-db-t" value="Conector de base de datos (no HTTP)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="680" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg-note" value="La flecha va desde quien hace la petición hacia quien la atiende.&lt;br&gt;Cada componente corre en su propio contenedor Docker." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="680" y="630" width="175" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
