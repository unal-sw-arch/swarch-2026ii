*.sqlite-wal
*.sqlite-shm
backups/

# Clientes Flutter: no forman parte de la imagen del backend
apps/operational_client/
apps/admin_client/

# Metadatos de herramientas
.kiro/
.git/
.gitignore
desktop.ini

# Docker
Dockerfile
docker-compose.yml
.dockerignore
