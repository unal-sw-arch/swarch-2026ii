{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "restauranteapp-cloud",
  "main": "apps/cloud_api/index.ts",
  "compatibility_date": "2026-09-12",
  "vars": {
    "ENVIRONMENT": "production"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RESTAURANT_COORDINATOR",
        "class_name": "RestaurantCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RestaurantCoordinator"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "restaurante-db",
      "database_id": "87cac56e-7ad5-489a-90a9-43a32a3a2cfa",
      "migrations_dir": "database/d1/migrations"
    }
  ]
}
