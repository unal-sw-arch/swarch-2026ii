# METADATABA DATABASE CONFIGURATION
POSTGRES_DB=metadataba_db
POSTGRES_USER=metadataba_user
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_ROOT_PASSWORD=crea_una_contrasena_distinta_y_segura
POSTGRES_HOST_PORT=5433
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# VIDEOS BLOB STORAGE (MinIO) CONFIGURATION
# MINIO_ROOT_USER debe tener al menos 3 caracteres y MINIO_ROOT_PASSWORD al menos 8.
MINIO_IMAGE=elestio/minio:latest
MINIO_ROOT_USER=videos_admin
MINIO_ROOT_PASSWORD=cambia_esta_contrasena_segura
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_BUCKET_NAME=streaming-videos

# RABBITMQ (defaults in Compose are for local development)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_USER=video_worker
RABBITMQ_PASSWORD=local_video_password
RABBITMQ_VHOST=/

# PROCESSING
PROCESSING_API_HOST_PORT=8086
TRANSCODING_WORKER_REPLICAS=1
WORKER_HEALTH_PORT=8091
HLS_SEGMENT_SECONDS=4
TRANSCODE_MAX_ATTEMPTS=3
TRANSCODE_RETRY_SECONDS=15
WORKER_LEASE_SECONDS=120
TRANSCODE_TIMEOUT_SECONDS=3600
FFMPEG_THREADS=2

## Streaming service
STREAMING_PORT=8082
DATABASE_URL=postgres://metadataba_user:cambia_la_pwd@localhost:5432/metadataba_db
REDIS_URL=redis://redis:6379
METADATA_TTL=60
PLAYLIST_TTL=600

## Users database + Auth service
USERS_DB_USER=users_user
USERS_DB_PASSWORD=cambia_esta_contrasena
USERS_DB_HOST_PORT=5434
# Secreto compartido por auth-service (firma) y api-gateway (verificación)
JWT_SECRET=cambia_este_secreto_largo_y_aleatorio
# Opcional: solo necesario para el inicio de sesión con Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

## API Gateway + Frontend
API_GATEWAY_HOST_PORT=6767
FRONTEND_HOST_PORT=8080

## Recommendation service
RECOMMENDATION_PORT=8088
NODE_ENV=development

QDRANT_URL=http://qdrant:6333

VIDEO_COLLECTION=video_embeddings
USER_COLLECTION=user_embeddings

EMBEDDING_MODEL_VERSION=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2@e8f8c211226b894fcb81acc59f3b34ba3efd5f42
TEXT_TEMPLATE_VERSION=video-text-v1

DEFAULT_RECOMMENDATION_LIMIT=20
MAX_RECOMMENDATION_LIMIT=50
CANDIDATE_MULTIPLIER=3

## Embeddings service - video vectors and weighted user profiles
# Internal URL: http://embeddings-service:8090 (not published to the host).
QDRANT_TIMEOUT_SECONDS=5
# Retry collection initialization after a transient Qdrant startup failure.
QDRANT_INIT_RETRY_SECONDS=5
# Qdrant REST/dashboard host port; both embedding collections share one instance.
QDRANT_HOST_PORT=6333
# Pinned model configuration is in embeddings_service/models.json.
EMBEDDING_MODEL_KEY=minilm
EMBEDDING_CPU_THREADS=4
VIDEO_LOCK_TIMEOUT_SECONDS=5
USER_LOCK_TIMEOUT_SECONDS=5
# Internal producer-to-Embeddings HTTP delivery; also used by Interaction Worker.
EMBEDDINGS_URL=http://embeddings-service:8090
EMBEDDINGS_CONNECT_TIMEOUT_SECONDS=5
EMBEDDINGS_RESPONSE_TIMEOUT_SECONDS=60
EMBEDDINGS_RETRY_SECONDS=2
# Download the selected model before starting Embeddings; Compose mounts
# ./artifacts/embeddings/models read-only. Vectors have 384 dimensions.

## Interactions service + worker (MongoDB)
# Keep the password URL-safe (letters, digits, - _ .): it is embedded in MONGODB_URI.
INTERACTIONS_DB_USER=interactions_user
INTERACTIONS_DB_PASSWORD=cambia_esta_contrasena
INTERACTIONS_DB_NAME=interactions
INTERACTIONS_DB_HOST_PORT=27017
INTERACTIONS_API_HOST_PORT=8087
INTERACTION_WORKER_REPLICAS=1
# For running the service/worker outside Docker:
MONGODB_URI=mongodb://interactions_user:cambia_esta_contrasena@localhost:27017/?authSource=admin
MONGODB_DB=interactions

# Profile recalculation (contract 1.0). The Worker sends counts, never weights.
# Uses EMBEDDINGS_CONNECT_TIMEOUT_SECONDS / EMBEDDINGS_RESPONSE_TIMEOUT_SECONDS above.
EMBEDDINGS_API_URL=http://embeddings-service:8090
PROFILE_UPDATE_THRESHOLD=10
# Base for 2/5/15/30/60-second retries and partial reconciliation.
PROFILE_RETRY_SECONDS=2
# Must exceed connect + response timeout by at least 10 seconds.
PROFILE_LEASE_SECONDS=120
PROFILE_SWEEP_SECONDS=1
# Each distinct playback start counts; no time window or per-video cap.
# The API keeps the legacy field name completed_views for these counts.
