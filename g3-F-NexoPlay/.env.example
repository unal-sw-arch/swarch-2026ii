# METADATABA DATABASE CONFIGURATION
POSTGRES_DB=metadataba_db
POSTGRES_USER=metadataba_user
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_ROOT_PASSWORD=crea_una_contrasena_distinta_y_segura
POSTGRES_HOST_PORT=5433
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# VIDEOS BLOB STORAGE (MinIO) CONFIGURATION
# MINIO_ROOT_USER debe tener al menos 3 caracteres y MINIO_ROOT_PASSWORD al menos 8.
MINIO_IMAGE=elestio/minio:latest
MINIO_ROOT_USER=videos_admin
MINIO_ROOT_PASSWORD=cambia_esta_contrasena_segura
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_BUCKET_NAME=streaming-videos

# RABBITMQ (defaults in Compose are for local development)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_USER=video_worker
RABBITMQ_PASSWORD=local_video_password
RABBITMQ_VHOST=/

# PROCESSING
PROCESSING_API_HOST_PORT=8086
TRANSCODING_WORKER_REPLICAS=1
WORKER_HEALTH_PORT=8091
HLS_SEGMENT_SECONDS=4
TRANSCODE_MAX_ATTEMPTS=3
TRANSCODE_RETRY_SECONDS=15
WORKER_LEASE_SECONDS=120
TRANSCODE_TIMEOUT_SECONDS=3600
FFMPEG_THREADS=2

## Streaming service
STREAMING_PORT=8082
DATABASE_URL=postgres://metadataba_user:cambia_la_pwd@localhost:5432/metadataba_db
REDIS_URL=redis://redis:6379
METADATA_TTL=60
PLAYLIST_TTL=600

## Users database + Auth service
USERS_DB_USER=users_user
USERS_DB_PASSWORD=cambia_esta_contrasena
USERS_DB_HOST_PORT=5434
# Secreto compartido por auth-service (firma) y api-gateway (verificación)
JWT_SECRET=cambia_este_secreto_largo_y_aleatorio
# Opcional: solo necesario para el inicio de sesión con Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

## API Gateway + Frontend
API_GATEWAY_HOST_PORT=6767
FRONTEND_HOST_PORT=8080