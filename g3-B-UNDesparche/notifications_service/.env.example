# Copia este archivo a .env (no lo subas a git)

# Broker (el hostname "rabbitmq" es el nombre del servicio en docker-compose)
RABBITMQ_URL=amqp://undesparche:undesparche@rabbitmq:5672/

# ---- Proveedor de correo: "brevo" (principal) o "smtp" (respaldo) ----
MAIL_PROVIDER=brevo
# Sin credenciales (o con EMAIL_DRY_RUN=true) los correos solo se escriben en el log.
EMAIL_DRY_RUN=true

# Remitente: debe ser una dirección VERIFICADA en Brevo (Senders, domains & dedicated IPs -> Senders)
MAIL_FROM_EMAIL=jalzateco@unal.edu.co
MAIL_FROM_NAME=UNdesparche
MAIL_REPLY_TO=

# Brevo: Settings -> SMTP & API -> API Keys -> Generate (clave "xkeysib-...")
BREVO_API_KEY=

# Respaldo SMTP (MAIL_PROVIDER=smtp). Ejemplo Gmail: contraseña de aplicación (requiere verificación en 2 pasos)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Modo pruebas: redirige TODOS los correos a esta dirección (asunto: "[TEST -> original]")
SANDBOX_TO=

# Reintentos ante fallas temporales
MAX_RETRIES=5
RETRY_DELAY_MS=30000
PREFETCH=10

FRONTEND_URL=http://localhost:5172
# Habilita POST /dev/publish (pruebas sin Django). Desactivar en producción.
DEV_ENDPOINTS=true
