# Ruta al archivo de credenciales de Firebase Admin SDK
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# URLs de los microservicios aguas abajo (para desarrollo local)
# En Docker Compose se sobreescriben automáticamente por variables del docker-compose.yml
USERS_SERVICE_URL=http://localhost:8001
EVENTS_SERVICE_URL=http://localhost:8002
INVENTORY_SERVICE_URL=http://localhost:8003

# Tiempo de vida del caché de usuarios en memoria (segundos)
USER_CACHE_TTL_SECONDS=60

# Timeout máximo de peticiones a los microservicios (segundos)
HTTP_TIMEOUT_SECONDS=30

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5172,http://localhost:3000,http://127.0.0.1:5172,http://127.0.0.1:3000
