// Kanasta - Decomposition view (prototype 2)
digraph decomposition {
  graph [rankdir=LR, fontname="Helvetica", bgcolor="white", pad=0.3, nodesep=0.12, ranksep=0.5, label=<<b>Kanasta - Vista de Descomposición</b>>, labelloc=t, fontsize=18];
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled"];
  edge [arrowhead=none, color="#90A4AE"];
  Kanasta [fillcolor="#1f8a5b" fontcolor="white", label=<<font point-size="8">&lt;&lt;system&gt;&gt;</font><br/><b>Kanasta</b><br/><font point-size="8">sistema de software</font>>];
  presentacion [fillcolor="#C8E6C9", label=<<font point-size="8">&lt;&lt;subsystem&gt;&gt;</font><br/><b>Presentación</b>>];
  comunicacion [fillcolor="#C8E6C9", label=<<font point-size="8">&lt;&lt;subsystem&gt;&gt;</font><br/><b>Comunicación</b>>];
  logica [fillcolor="#C8E6C9", label=<<font point-size="8">&lt;&lt;subsystem&gt;&gt;</font><br/><b>Lógica de negocio</b>>];
  asincrono [fillcolor="#C8E6C9", label=<<font point-size="8">&lt;&lt;subsystem&gt;&gt;</font><br/><b>Mensajería asíncrona</b>>];
  datos [fillcolor="#C8E6C9", label=<<font point-size="8">&lt;&lt;subsystem&gt;&gt;</font><br/><b>Datos</b>>];
  web [fillcolor="#FFFFFF", label=<<font point-size="8">&lt;&lt;module&gt;&gt;</font><br/><b>Kanasta Web</b><br/><font point-size="8">web/</font>>];
  admin [fillcolor="#FFFFFF", label=<<font point-size="8">&lt;&lt;module&gt;&gt;</font><br/><b>Kanasta Admin</b><br/><font point-size="8">admin-desktop/</font>>];
  gateway [fillcolor="#FFFFFF", label=<<font point-size="8">&lt;&lt;module&gt;&gt;</font><br/><b>API Gateway</b><br/><font point-size="8">api-gateway/</font>>];
  catalog [fillcolor="#FFFFFF", label=<<font point-size="8">&lt;&lt;module&gt;&gt;</font><br/><b>Catalog Service</b><br/><font point-size="8">catalog-service/</font>>];
  orders [fillcolor="#FFFFFF", label=<<font point-size="8">&lt;&lt;module&gt;&gt;</font><br/><b>Orders Service</b><br/><font point-size="8">orders-service/</font>>];
  accounts [fillcolor="#FFFFFF", label=<<font point-size="8">&lt;&lt;module&gt;&gt;</font><br/><b>Accounts Service</b><br/><font point-size="8">accounts-service/</font>>];
  images [fillcolor="#FFFFFF", label=<<font point-size="8">&lt;&lt;module&gt;&gt;</font><br/><b>Image Provider</b><br/><font point-size="8">image-provider/</font>>];
  broker [fillcolor="#FFFFFF", label=<<font point-size="8">&lt;&lt;module&gt;&gt;</font><br/><b>Message Broker</b><br/><font point-size="8">RabbitMQ (configuración en docker-compose.yml)</font>>];
  notifications [fillcolor="#FFFFFF", label=<<font point-size="8">&lt;&lt;module&gt;&gt;</font><br/><b>Notifications Service</b><br/><font point-size="8">notifications-service/</font>>];
  catalogdb [fillcolor="#FFFFFF", label=<<font point-size="8">&lt;&lt;module&gt;&gt;</font><br/><b>Catalog DB</b><br/><font point-size="8">catalog-service/db/init.sql</font>>];
  accountsdb [fillcolor="#FFFFFF", label=<<font point-size="8">&lt;&lt;module&gt;&gt;</font><br/><b>Accounts DB</b><br/><font point-size="8">accounts-service/db/init.sql</font>>];
  ordersdb [fillcolor="#FFFFFF", label=<<font point-size="8">&lt;&lt;module&gt;&gt;</font><br/><b>Orders DB</b><br/><font point-size="8">orders-service/db/seed.js</font>>];
  notificationsdb [fillcolor="#FFFFFF", label=<<font point-size="8">&lt;&lt;module&gt;&gt;</font><br/><b>Notifications DB</b><br/><font point-size="8">se crea al guardar la configuración</font>>];
  web_routes [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Rutas y páginas</b><br/><font point-size="8">src/index.js</font>>];
  web_gateway [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Cliente del gateway</b><br/><font point-size="8">src/gateway.js</font>>];
  web_views [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Plantillas</b><br/><font point-size="8">views/*.ejs</font>>];
  web_format [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Formatos</b><br/><font point-size="8">src/format.js</font>>];
  admin_main [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Ventana principal</b><br/><font point-size="8">main.py, app/main_window.py</font>>];
  admin_api [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Cliente del gateway</b><br/><font point-size="8">app/api.py</font>>];
  admin_screens [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Pantallas</b><br/><font point-size="8">app/*_tab.py, login_dialog.py</font>>];
  gw_routes [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Enrutamiento</b><br/><font point-size="8">main.go: routes</font>>];
  gw_auth [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Sesión y permisos</b><br/><font point-size="8">main.go: currentUser, access</font>>];
  cat_main [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>API REST</b><br/><font point-size="8">app/main.py</font>>];
  cat_db [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Conexión a la base</b><br/><font point-size="8">app/database.py</font>>];
  cat_sql [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Tablas y datos</b><br/><font point-size="8">db/init.sql</font>>];
  ord_schema [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Esquema GraphQL</b><br/><font point-size="8">src/schema.js</font>>];
  ord_resolvers [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Reglas de pedidos</b><br/><font point-size="8">src/resolvers.js</font>>];
  ord_catalog [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Cliente del catálogo</b><br/><font point-size="8">src/catalogClient.js</font>>];
  ord_pub [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Publicador de eventos</b><br/><font point-size="8">src/publisher.js</font>>];
  ord_db [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Conexión a la base</b><br/><font point-size="8">src/db.js</font>>];
  acc_ctrl [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>API REST</b><br/><font point-size="8">AccountController.java</font>>];
  acc_repo [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Acceso a datos</b><br/><font point-size="8">UserRepository.java</font>>];
  acc_pub [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Publicador de eventos</b><br/><font point-size="8">NotificationPublisher.java</font>>];
  acc_seed [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Cuentas de ejemplo</b><br/><font point-size="8">DataSeeder.java</font>>];
  img_index [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>API de imágenes</b><br/><font point-size="8">src/index.js</font>>];
  img_files [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Imágenes</b><br/><font point-size="8">images/</font>>];
  not_consumer [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Lector de la cola</b><br/><font point-size="8">consumer.go</font>>];
  not_email [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Correos y Resend</b><br/><font point-size="8">email.go</font>>];
  not_db [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>Configuración e historial</b><br/><font point-size="8">database.go</font>>];
  not_api [fillcolor="#F5F5F5", label=<<font point-size="8">&lt;&lt;submodule&gt;&gt;</font><br/><b>API REST</b><br/><font point-size="8">main.go</font>>];
  Kanasta -> presentacion;
  Kanasta -> comunicacion;
  Kanasta -> logica;
  Kanasta -> asincrono;
  Kanasta -> datos;
  presentacion -> web;
  presentacion -> admin;
  comunicacion -> gateway;
  logica -> catalog;
  logica -> orders;
  logica -> accounts;
  logica -> notifications;
  logica -> images;
  asincrono -> broker;
  datos -> catalogdb;
  datos -> accountsdb;
  datos -> ordersdb;
  datos -> notificationsdb;
  web -> web_routes;
  web -> web_gateway;
  web -> web_views;
  web -> web_format;
  admin -> admin_main;
  admin -> admin_api;
  admin -> admin_screens;
  gateway -> gw_routes;
  gateway -> gw_auth;
  catalog -> cat_main;
  catalog -> cat_db;
  catalog -> cat_sql;
  orders -> ord_schema;
  orders -> ord_resolvers;
  orders -> ord_catalog;
  orders -> ord_pub;
  orders -> ord_db;
  accounts -> acc_ctrl;
  accounts -> acc_repo;
  accounts -> acc_pub;
  accounts -> acc_seed;
  images -> img_index;
  images -> img_files;
  notifications -> not_consumer;
  notifications -> not_email;
  notifications -> not_db;
  notifications -> not_api;
}
